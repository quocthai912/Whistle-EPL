# Key inventory only. Supply values in a protected file outside Git.
# Separate COMPOSE_PROJECT_NAME, volumes, directories and DB per dev/test/operational profile.
COMPOSE_PROJECT_NAME=
POSTGRES_DB=
POSTGRES_USER=
DATABASE_PASSWORD_FILE=
BACKEND_ENV_FILE=
OPERATION_STATE_DIR=
HTTPS_BIND=
SITE_ADDRESS=
AUTH_ORIGIN=
# Dedicated private network and reserved Caddy IPv4, chosen by the host operator.
PRIVATE_SUBNET=
# CIDR inside PRIVATE_SUBNET for dynamic allocations; must exclude CADDY_PRIVATE_IP.
PRIVATE_DYNAMIC_RANGE=
CADDY_PRIVATE_IP=
CADDY_IMAGE=
# Backend/host operator environment (DATABASE_URL contains a secret; never print it).
DATABASE_URL=
MAINTENANCE_MARKER_PATH=
# Direct backend profiles: exact trusted immediate proxy CIDRs, or empty for direct peers.
# Compose sets this to CADDY_PRIVATE_IP/32; never trust arbitrary forwarding headers.
AUTH_TRUSTED_PROXY_CIDRS=
# Backup host: absolute protected paths; libpq PGSERVICE/PGPASSFILE outside Git.
OPS_PROFILE=
OPS_CONFIG_FILE=
OPS_STATE_DIR=
OPS_BACKUP_DIR=
OPS_APP_DIR=
OPS_DB_NAME=
OPS_ISOLATED=
PGSERVICE=
PGPASSFILE=
OPS_OFFHOST_DIR=
