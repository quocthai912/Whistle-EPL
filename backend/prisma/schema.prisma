  updatedAt        DateTime                        @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([seasonId, id])
  @@unique([registrationId, id])
  @@unique([seasonId, registrationId, id])
  @@unique([id, currentVersionId])
  @@index([seasonId, registrationId])
  @@map("registration_correction_case")
}

model RegistrationCorrectionVersion {
  id                   String                                @id @default(uuid(4)) @db.Uuid
  seasonId             String                                @map("season_id") @db.Uuid
  registrationId       String                                @map("registration_id") @db.Uuid
  caseId               String                                @map("case_id") @db.Uuid
  correctionCase       RegistrationCorrectionCase            @relation("registrationCorrectionCaseVersions", fields: [seasonId, registrationId, caseId], references: [seasonId, registrationId, id], onDelete: Restrict, onUpdate: NoAction)
  currentFor           RegistrationCorrectionCase[]          @relation("registrationCorrectionCurrentVersion")
  versionNumber        Int                                   @map("version_number")
  preparedBy           String                                @map("prepared_by") @db.Uuid
  preparer             Account                               @relation("registrationCorrectionPreparer", fields: [preparedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  predecessorVersionId String?                               @map("predecessor_version_id") @db.Uuid
  predecessor          RegistrationCorrectionVersion?        @relation("registrationCorrectionPredecessor", fields: [caseId, predecessorVersionId], references: [caseId, id], onDelete: NoAction, onUpdate: NoAction)
  successors           RegistrationCorrectionVersion[]       @relation("registrationCorrectionPredecessor")
  revision             BigInt                                @default(1)
  state                String                                @default("DRAFT")
  submittedAt          DateTime?                             @map("submitted_at") @db.Timestamptz(6)
  decidedAt            DateTime?                             @map("decided_at") @db.Timestamptz(6)
  decidedBy            String?                               @map("decided_by") @db.Uuid
  decider              Account?                              @relation("registrationCorrectionDecider", fields: [decidedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  decisionReason       String?                               @map("decision_reason")
  targetVersionId      String                                @map("target_version_id") @db.Uuid
  targetVersion        RegistrationVersion                   @relation("correctionTargetVersion", fields: [registrationId, targetVersionId], references: [caseId, id], onDelete: Restrict, onUpdate: NoAction)
  proposedVersionId    String                                @map("proposed_version_id") @db.Uuid
  proposedVersion      RegistrationVersion                   @relation("correctionProposedVersion", fields: [registrationId, proposedVersionId], references: [caseId, id], onDelete: Restrict, onUpdate: NoAction)
  reason               String?
  basis                String?
  disposition          String?
  beforeSummary        Json?                                 @map("before_summary") @db.JsonB
  afterSummary         Json?                                 @map("after_summary") @db.JsonB
  affectedReferences   Json?                                 @map("affected_references") @db.JsonB
  createdAt            DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  editors              RegistrationCorrectionVersionEditor[]
  segments             RegistrationCorrectionSegment[]

  @@unique([caseId, versionNumber])
  @@unique([caseId, id])
  @@unique([seasonId, id])
  @@index([preparedBy])
  @@index([decidedBy])
  @@index([targetVersionId])
  @@index([proposedVersionId])
  @@map("registration_correction_version")
}

model RegistrationCorrectionVersionEditor {
  versionId     String                        @map("version_id") @db.Uuid
  version       RegistrationCorrectionVersion @relation(fields: [versionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  accountId     String                        @map("account_id") @db.Uuid
  account       Account                       @relation("registrationCorrectionVersionEditorAccount", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  firstEditedAt DateTime                      @default(now()) @map("first_edited_at") @db.Timestamptz(6)

  @@id([versionId, accountId])
  @@index([accountId])
  @@map("registration_correction_version_editor")
}

model RegistrationCorrectionSegment {
  id                  String                        @id @default(uuid(4)) @db.Uuid
  seasonId            String                        @map("season_id") @db.Uuid
  correctionVersionId String                        @map("correction_version_id") @db.Uuid
  correctionVersion   RegistrationCorrectionVersion @relation(fields: [seasonId, correctionVersionId], references: [seasonId, id], onDelete: Restrict, onUpdate: NoAction)
  segmentOrder        Int                           @map("segment_order")
  segmentStart        DateTime                      @map("segment_start") @db.Timestamptz(6)
  segmentEnd          DateTime?                     @map("segment_end") @db.Timestamptz(6)
  regulationVersionId String                        @map("regulation_version_id") @db.Uuid
  regulationVersion   RegulationVersion             @relation("correctionSegmentRegulation", fields: [seasonId, regulationVersionId], references: [seasonId, id], onDelete: Restrict, onUpdate: NoAction)
  outcome             String
  findings            Json                          @db.JsonB
  requiredDisposition String?                       @map("required_disposition")
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([correctionVersionId, segmentOrder])
  @@index([regulationVersionId])
  @@map("registration_correction_segment")
}

