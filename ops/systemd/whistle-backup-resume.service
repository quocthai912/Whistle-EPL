[Unit]
Description=Whistle-EPL reconcile pending or missed backup after boot
OnFailure=whistle-backup-retry-1.timer

[Service]
Type=oneshot
User=whistle-operator
Group=whistle-operations
EnvironmentFile=/etc/whistle-epl/operator.env
WorkingDirectory=/opt/whistle-epl
ExecStart=/opt/whistle-epl/ops/backup/scheduled-backup.sh resume
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/whistle-epl-operations /srv/whistle/backups
